# Ortam: development veya production
ENV=development

# Üretimde mutlaka güçlü ve rastgele değer kullan.
# Örnek üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key-before-production

# İlk admin hesabı. Veritabanında admin yoksa uygulama başlangıcında oluşturulur.
ADMIN_EMAIL=admin@kobi.com
ADMIN_PASSWORD=Admin12345!
ADMIN_PHONE=

# SQLite demo/prototip için uygundur. Gerçek yayında PostgreSQL önerilir.
DATABASE_PATH=isletme.db

# Opsiyonel AI anahtarı
GEMINI_API_KEY=
